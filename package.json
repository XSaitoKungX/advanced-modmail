{
  "name": "advanced-modmail",
  "version": "0.0.0",
  "description": "Advanced, configurable and open-source Modmail for Discord.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.4.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "modmail",
    "moderation",
    "support",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XSaitoKungX/advanced-modmail.git"
  },
  "bugs": {
    "url": "https://github.com/XSaitoKungX/advanced-modmail/issues"
  },
  "homepage": "https://github.com/XSaitoKungX/advanced-modmail#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.28.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  }
}
